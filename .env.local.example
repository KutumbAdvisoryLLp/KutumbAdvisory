# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to client code. Used by Route Handlers that need
# to bypass RLS (e.g. admin-verified operations). Keep out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (newsletter sending) — resend.com
RESEND_API_KEY=
# Must be a domain you've verified in Resend, otherwise sends fail or land in spam.
NEWSLETTER_FROM_EMAIL=

# Used only by `npm run create-admin` to provision the initial admin account
# (creates the Supabase Auth user + admin_users row). Not read by the app itself.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay (mykundali ₹999 unlock) — dashboard.razorpay.com → Settings → API Keys.
# Use Test Mode keys (key id starts with rzp_test_) until you're ready to take
# real payments, then switch to Live Mode keys (rzp_live_...). Both are read
# server-side only, by src/app/api/mykundali/payment/*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
